[Desktop Entry]
Name=LocalShot
GenericName=Screenshot Tool
Comment=Privacy-First Offline Screenshot Tool
Exec=localshot --area
Icon=localshot
Terminal=false
Type=Application
Categories=Utility;
Keywords=screenshot;capture;lightshot;localshot;screen;snip;
StartupNotify=false
StartupWMClass=localshot-overlay
Actions=Area;Full;

[Desktop Action Area]
Name=Take Area Screenshot
Exec=localshot --area

[Desktop Action Full]
Name=Capture Full Screen
Exec=localshot --full
