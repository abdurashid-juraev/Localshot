[Desktop Entry]
Name=LocalShot
GenericName=Screenshot Tool
Comment=100% Offline Privacy-First Lightshot Clone
Exec=sh -c 'exec "$HOME/.local/bin/localshot"'
Icon=localshot
Terminal=false
Type=Application
Categories=Utility;Graphics;Photography;
Keywords=screenshot;capture;lightshot;localshot;screen;snip;
StartupNotify=false
