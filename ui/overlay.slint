export struct TouchModifiers {
    control: bool,
    shift: bool,
    alt: bool,
}

component ResizeHandleDot inherits Rectangle {
    width: 10px;
    height: 10px;
    background: #ffffff;
    border-color: #0088ff;
    border-width: 1.5px;
    border-radius: 2px;
    drop-shadow-blur: 3px;
    drop-shadow-color: #00000066;
}

component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip-title;
    in property <string> tooltip-shortcut: "";
    in property <string> tooltip-side: "left"; // "left", "top", "right"
    in property <bool> active: false;
    in property <color> hover-tint: #ffffff22;
    in property <color> active-bg: #2563eb;
    in property <color> custom-icon-color: #cbd5e1;
    in property <color> hover-icon-color: #ffffff;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: root.active ? root.active-bg : (touch.has-hover ? root.hover-tint : transparent);
    border-color: root.active ? #60a5fa : (touch.has-hover ? #ffffff33 : transparent);
    border-width: 1px;

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: root.active ? #ffffff : (touch.has-hover ? root.hover-icon-color : root.custom-icon-color);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Floating Tooltip Badge
    if touch.has-hover && root.tooltip-title != "" : tip-box := Rectangle {
        x: root.tooltip-side == "left" ? -self.width - 10px : 
           (root.tooltip-side == "top" ? (parent.width - self.width) / 2 : parent.width + 10px);
        y: root.tooltip-side == "top" ? -34px : (parent.height - self.height) / 2;
        width: tip-layout.preferred-width + 18px;
        height: 28px;
        background: #0f172a;
        border-radius: 6px;
        border-color: #334155;
        border-width: 1px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #000000bb;
        z: 200;

        tip-layout := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: center;

            Text {
                text: root.tooltip-title;
                font-size: 12px;
                font-weight: 600;
                color: #f8fafc;
                vertical-alignment: center;
            }

            if root.tooltip-shortcut != "" : Rectangle {
                background: #1e293b;
                border-radius: 4px;
                border-color: #475569;
                border-width: 1px;
                width: sc-text.preferred-width + 8px;
                height: 18px;

                sc-text := Text {
                    text: root.tooltip-shortcut;
                    font-size: 10px;
                    font-weight: 700;
                    color: #94a3b8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component ColorDot inherits Rectangle {
    in property <color> dot-color;
    in property <string> tooltip-title;
    in property <bool> is-active: false;
    callback clicked();

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: root.dot-color;
    border-color: root.is-active ? #ffffff : (dot-touch.has-hover ? #ffffffbb : #00000066);
    border-width: root.is-active ? 2px : 1.2px;
    drop-shadow-blur: root.is-active ? 5px : 0px;
    drop-shadow-color: #ffffff88;

    dot-touch := TouchArea {
        x: -3px;
        y: -3px;
        width: 22px;
        height: 22px;
        clicked => { root.clicked(); }
    }

    if dot-touch.has-hover && root.tooltip-title != "" : tip-dot := Rectangle {
        x: -self.width - 10px;
        y: (parent.height - self.height) / 2;
        width: dot-tip-txt.preferred-width + 16px;
        height: 24px;
        background: #0f172a;
        border-radius: 5px;
        border-color: #334155;
        border-width: 1px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #000000aa;
        z: 200;

        dot-tip-txt := Text {
            text: root.tooltip-title;
            font-size: 11px;
            font-weight: 600;
            color: #f8fafc;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component OverlayWindow inherits Window {
    title: "localshot-overlay";
    in-out property <image> background-image;
    in-out property <bool> is-selecting: false;
    in-out property <bool> has-selection: false;
    in-out property <length> sel-x: 0px;
    in-out property <length> sel-y: 0px;
    in-out property <length> sel-w: 0px;
    in-out property <length> sel-h: 0px;
    in-out property <string> dimension-text: "";

    // Active tool: "select", "pen", "line", "arrow", "rect", "marker", "redact"
    in-out property <string> active-tool: "select";
    // Active color index: 0=Red, 1=Blue, 2=Green, 3=Yellow, 4=White, 5=Black
    in-out property <int> active-color-idx: 0;

    // Cursor driven dynamically by Rust hit-testing
    in-out property <string> cursor-name: "crosshair";

    // Dual toolbar positions computed by Rust pure function
    in-out property <bool> show-toolbars: false;
    in-out property <length> vert-toolbar-x: 0px;
    in-out property <length> vert-toolbar-y: 0px;
    in-out property <length> horiz-toolbar-x: 0px;
    in-out property <length> horiz-toolbar-y: 0px;

    callback close-requested();
    callback copy-requested();
    callback save-requested();
    callback undo-requested();
    callback redo-requested();
    callback tool-selected(string);
    callback color-selected(int);

    // Single unified interaction callbacks
    callback touch-event(string, length, length, TouchModifiers, bool);
    callback key-event(string, bool, bool, bool);
    callback escape-pressed();

    // Direct keyboard focus to key-handler on every show
    forward-focus: key-handler;

    public function toggle-tool(tool: string) {
        root.active-tool = root.active-tool == tool ? "select" : tool;
        root.tool-selected(root.active-tool);
    }

    public function select-color(idx: int) {
        root.active-color-idx = idx;
        root.color-selected(idx);
    }

    no-frame: true;
    always-on-top: true;

    // Desktop background (rendered 1:1)
    Image {
        width: 100%;
        height: 100%;
        source: root.background-image;
        image-rendering: pixelated;
    }

    // Dimmed overlay
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
    }

    // Single Full-Window Interaction TouchArea
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.cursor-name == "crosshair" ? crosshair : (
            root.cursor-name == "move" ? move : (
                root.cursor-name == "nwse-resize" ? nwse-resize : (
                    root.cursor-name == "nesw-resize" ? nesw-resize : (
                        root.cursor-name == "ns-resize" ? ns-resize : (
                            root.cursor-name == "ew-resize" ? ew-resize : default
                        )
                    )
                )
            )
        );

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.touch-event("down", self.mouse-x, self.mouse-y, { control: event.modifiers.control, shift: event.modifiers.shift, alt: event.modifiers.alt }, self.pressed);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.touch-event("up", self.mouse-x, self.mouse-y, { control: event.modifiers.control, shift: event.modifiers.shift, alt: event.modifiers.alt }, self.pressed);
            } else if (event.kind == PointerEventKind.move) {
                root.touch-event("move", self.mouse-x, self.mouse-y, { control: event.modifiers.control, shift: event.modifiers.shift, alt: event.modifiers.alt }, self.pressed);
            }
        }

        moved => {
            root.touch-event("move", self.mouse-x, self.mouse-y, { control: false, shift: false, alt: false }, self.pressed);
        }
    }

    // Cutout Viewport (1:1 unscaled desktop rendering through cutout)
    if root.has-selection || root.is-selecting : Rectangle {
        x: root.sel-x;
        y: root.sel-y;
        width: root.sel-w;
        height: root.sel-h;
        clip: true;

        Image {
            x: -root.sel-x;
            y: -root.sel-y;
            width: root.width;
            height: root.height;
            source: root.background-image;
            image-rendering: pixelated;
        }

        // Selection border
        Rectangle {
            width: 100%;
            height: 100%;
            border-color: #0088ff;
            border-width: 1.5px;
        }
    }

    // Dimension Badge
    if (root.has-selection || root.is-selecting) && root.sel-w > 20px && root.sel-h > 20px : Rectangle {
        x: root.sel-x;
        y: root.sel-y > 28px ? root.sel-y - 28px : root.sel-y + 6px;
        width: 104px;
        height: 24px;
        background: #0f172aee;
        border-radius: 6px;
        border-color: #334155;
        border-width: 1px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000088;

        Text {
            text: root.dimension-text;
            color: #f8fafc;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 8-Point Visual Resize Handles (Pure visual representation; hit testing owned by Rust)
    if root.has-selection && !root.is-selecting && root.active-tool == "select" && root.sel-w > 16px && root.sel-h > 16px : Rectangle {
        x: root.sel-x;
        y: root.sel-y;
        width: root.sel-w;
        height: root.sel-h;

        // Top-Left (NW)
        ResizeHandleDot { x: -5px; y: -5px; }
        // Top (N)
        ResizeHandleDot { x: (parent.width - 10px) / 2; y: -5px; }
        // Top-Right (NE)
        ResizeHandleDot { x: parent.width - 5px; y: -5px; }
        // Left (W)
        ResizeHandleDot { x: -5px; y: (parent.height - 10px) / 2; }
        // Right (E)
        ResizeHandleDot { x: parent.width - 5px; y: (parent.height - 10px) / 2; }
        // Bottom-Left (SW)
        ResizeHandleDot { x: -5px; y: parent.height - 5px; }
        // Bottom (S)
        ResizeHandleDot { x: (parent.width - 10px) / 2; y: parent.height - 5px; }
        // Bottom-Right (SE)
        ResizeHandleDot { x: parent.width - 5px; y: parent.height - 5px; }
    }

    // ==========================================
    // DUAL TOOLBAR (Lightshot 1:1 Floating Bars)
    // ==========================================
    if root.show-toolbars : Rectangle {
        // --- VERTICAL TOOLBAR ---
        Rectangle {
            x: root.vert-toolbar-x;
            y: root.vert-toolbar-y;
            width: 48px;
            height: 368px;
            background: #1e222bcc;
            border-radius: 10px;
            border-color: #334155;
            border-width: 1px;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000088;

            TouchArea {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                padding: 4px;
                spacing: 3px;
                alignment: center;

                ToolButton {
                    icon: @image-url("../assets/icons/pen.svg");
                    tooltip-title: "Pen (Freehand)";
                    tooltip-shortcut: "P";
                    active: root.active-tool == "pen";
                    clicked => { root.toggle-tool("pen"); }
                }
                ToolButton {
                    icon: @image-url("../assets/icons/line.svg");
                    tooltip-title: "Line (Straight)";
                    tooltip-shortcut: "L";
                    active: root.active-tool == "line";
                    clicked => { root.toggle-tool("line"); }
                }
                ToolButton {
                    icon: @image-url("../assets/icons/arrow.svg");
                    tooltip-title: "Arrow";
                    tooltip-shortcut: "A";
                    active: root.active-tool == "arrow";
                    clicked => { root.toggle-tool("arrow"); }
                }
                ToolButton {
                    icon: @image-url("../assets/icons/rect.svg");
                    tooltip-title: "Rectangle";
                    tooltip-shortcut: "R";
                    active: root.active-tool == "rect";
                    clicked => { root.toggle-tool("rect"); }
                }
                ToolButton {
                    icon: @image-url("../assets/icons/marker.svg");
                    tooltip-title: "Highlighter";
                    tooltip-shortcut: "M";
                    active: root.active-tool == "marker";
                    clicked => { root.toggle-tool("marker"); }
                }
                ToolButton {
                    icon: @image-url("../assets/icons/redact.svg");
                    tooltip-title: "Blur / Redact";
                    tooltip-shortcut: "B";
                    active: root.active-tool == "redact";
                    clicked => { root.toggle-tool("redact"); }
                }

                // Separator line
                Rectangle { height: 1px; background: #334155; }

                // Color palette circles
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    ColorDot { dot-color: #e53935; tooltip-title: "Red"; is-active: root.active-color-idx == 0; clicked => { root.select-color(0); } }
                    ColorDot { dot-color: #1e88e5; tooltip-title: "Blue"; is-active: root.active-color-idx == 1; clicked => { root.select-color(1); } }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    ColorDot { dot-color: #43a047; tooltip-title: "Green"; is-active: root.active-color-idx == 2; clicked => { root.select-color(2); } }
                    ColorDot { dot-color: #fdd835; tooltip-title: "Yellow"; is-active: root.active-color-idx == 3; clicked => { root.select-color(3); } }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    ColorDot { dot-color: #ffffff; tooltip-title: "White"; is-active: root.active-color-idx == 4; clicked => { root.select-color(4); } }
                    ColorDot { dot-color: #212121; tooltip-title: "Black"; is-active: root.active-color-idx == 5; clicked => { root.select-color(5); } }
                }

                Rectangle { height: 1px; background: #334155; }

                ToolButton {
                    icon: @image-url("../assets/icons/undo.svg");
                    tooltip-title: "Undo";
                    tooltip-shortcut: "Ctrl+Z";
                    clicked => { root.undo-requested(); }
                }
            }
        }

        // --- HORIZONTAL TOOLBAR ---
        Rectangle {
            x: root.horiz-toolbar-x;
            y: root.horiz-toolbar-y;
            width: 156px;
            height: 46px;
            background: #1e222bcc;
            border-radius: 10px;
            border-color: #334155;
            border-width: 1px;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000088;

            TouchArea {
                width: 100%;
                height: 100%;
            }

            HorizontalLayout {
                padding: 4px;
                spacing: 6px;
                alignment: center;

                ToolButton {
                    icon: @image-url("../assets/icons/close.svg");
                    tooltip-title: "Close";
                    tooltip-shortcut: "Esc";
                    tooltip-side: "top";
                    hover-tint: #ef444433;
                    hover-icon-color: #f87171;
                    clicked => { root.close-requested(); }
                }
                ToolButton {
                    icon: @image-url("../assets/icons/save.svg");
                    tooltip-title: "Save to File";
                    tooltip-shortcut: "Ctrl+S";
                    tooltip-side: "top";
                    hover-tint: #10b98133;
                    hover-icon-color: #34d399;
                    clicked => { root.save-requested(); }
                }
                ToolButton {
                    icon: @image-url("../assets/icons/copy.svg");
                    tooltip-title: "Copy to Clipboard";
                    tooltip-shortcut: "Ctrl+C";
                    tooltip-side: "top";
                    hover-tint: #3b82f633;
                    hover-icon-color: #60a5fa;
                    clicked => { root.copy-requested(); }
                }
            }
        }
    }

    // Keyboard Shortcuts
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escape-pressed();
                accept
            } else if (event.text == Key.Return) {
                root.copy-requested();
                accept
            } else {
                root.key-event(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                accept
            }
        }
    }
}
